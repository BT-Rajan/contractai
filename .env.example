APP_ENV=development
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=contractai
DB_USER=root
DB_PASS=

# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_TTL=3600
JWT_REFRESH=604800

# Get your key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Encryption key for sensitive DB fields (reg numbers, tax IDs, signatory names)
# MUST be different from JWT_SECRET — rotating JWT_SECRET won't break encrypted data
# Generate: openssl rand -hex 32
ENCRYPT_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# Setup endpoint — used once to bootstrap admin account, then remove from .env
# Only works when APP_ENV=development and APP_DEBUG=true
SETUP_EMAIL=admin@yourcompany.com
SETUP_PASSWORD=ChangeMe123!

# Razorpay payment gateway — get keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_CURRENCY=INR
